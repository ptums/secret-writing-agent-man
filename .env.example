DATABASE_URL=postgres://postgres@localhost:5432/writer_agent
OLLAMA_BASE_URL=http://localhost:11434
# Talks to the user, finds documents, routes requests. Must support tool calling.
DISCUSSION_MODEL=qwen3:8b
# Produces the actual copy. Use the strongest model that fits in GPU memory
# (e.g. gemma4:26b needs ~20GB+; on 16GB machines it falls back to CPU and is very slow).
WRITER_MODEL=qwen3:8b
# Reviews every draft and handles revisions.
EDITOR_MODEL=qwen3:8b
# true = reason before drafting (2–3x slower; no measurable quality gain with qwen3:8b).
WRITER_THINK=false
